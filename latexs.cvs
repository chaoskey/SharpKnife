; 批注

\cancel	右斜删除符 \cancel{5}
\bcancel	左斜删除符 \bcancel{5}
\xcancel	叉删除符 \xcancel{ABC}
\boxed	方框符 \boxed{\pi=\frac c d}


; 垂直布局

\stackrel	上标记 \stackrel{!}{=}	{Text}\stackrel{!}{=}##{Left 4}
\overset	上标记 \overset{!}{=}	{Text}\overset{!}{=}##{Left 4}
\underset	下标记 \underset{!}{=}	{Text}\underset{!}{=}##{Left 4}


; 一些块结构

; ##将字符串分成多个部分，每个部分都可设置成不同的“特殊模式”
; 比如: 盲从模式{Blind} 【默认】；原始模式{Raw}； 文本模式{Text}
; https://www.autoahk.com/help/autohotkey/zh-cn/docs/commands/Send.htm#Special_modes

\array	数组 \begin{array} ...	{Text}\begin{array}{cc} a & b \\ c & d \end{array}##{Left 25}
\subarray	上下标数组 \begin{subarray}{l} ...	{Text}\begin{subarray}{l} i \\ j \end{subarray}##{Left 20}
\arraystretch	表格数组 \def\arraystretch{1.5} ...	{Text}\def\arraystretch{1.5}\begin{array}{c:c:c} a & b & c \\ \hline d & e & f \\ \hdashline g & h & i \end{array}##{Left 64}
\matrix	无定界矩阵 \begin{matrix} ...	{Text}\begin{matrix} a & b \\ c & d \end{matrix}##{Left 26}
\pmatrix	圆括号矩阵 \begin{pmatrix} ...	{Text}\begin{pmatrix} a & b \\ c & d \end{pmatrix}##{Left 27}
\bmatrix	方括号矩阵 \begin{bmatrix} ...	{Text}\begin{bmatrix} a & b \\ c & d \end{bmatrix}##{Left 27}
\vmatrix	竖括号矩阵(行列式) \begin{vmatrix} ...	{Text}\begin{vmatrix} a & b \\ c & d \end{vmatrix}##{Left 27}
\Vmatrix	双竖括号矩阵 \begin{Vmatrix} ...	{Text}\begin{Vmatrix} a & b \\ c & d \end{Vmatrix}##{Left 27}
\Bmatrix	花括号矩阵 \begin{Bmatrix} ...	{Text}\begin{Bmatrix} a & b \\ c & d \end{Bmatrix}##{Left 27}
\cases	左条件分支 \begin{cases} ...	{Text}\begin{cases} a &\text{if } b \\ c &\text{if } d \end{cases}##{Left 45}
\align	对齐 begin{align} ...	{Text}\begin{align} a&=b+c \\ d+e&=f \end{align}##{Left 27}
\alignat	紧凑对齐 begin{alignat} ...	{Text}\begin{alignat}{1} 10&x+&3&y=2\\ 3&x+&13&y=4 \end{alignat}##{Left 37}
\gather	居中对齐 begin{gather} ...	{Text}\begin{gather} a=b \\ e=b+c \end{gather}##{Left 24}


; 补全G：可延伸箭头（可加可选参数）
\xleftarrow	上标记左箭头 \xleftarrow{abc}	{Text}\xleftarrow{abc}##{Left 4}
\xrightarrow	上标记右箭头 \xrightarrow{abc}	{Text}\xrightarrow{abc}##{Left 4}
\xtwoheadleftarrow	上标记左二头箭头 \xtwoheadleftarrow{abc}	{Text}\xtwoheadleftarrow{abc}##{Left 4}
\xtwoheadrightarrow	上标记右二头箭头 \xtwoheadrightarrow{abc}	{Text}\xtwoheadrightarrow{abc}##{Left 4}
\xtofrom	上标记往返箭头 \xtofrom{abc}	{Text}\xtofrom{abc}##{Left 4}
\xmapsto	上标记映射箭头 \xmapsto{abc}	{Text}\xmapsto{abc}##{Left 4}
\xlongequal	上标记等号 \xlongequal{abc}	{Text}\xlongequal{abc}##{Left 4}

; 补全J：颜色
\color	颜色切换 \color{blue}	{Text}\color{blue}##{Left 5}
\textcolor	文本颜色 \textcolor{blue}{F=ma}	{Text}\textcolor{blue}{F=ma}##{Left 11}
\colorbox	颜色框 \colorbox{aqua}{text}	{Text}\colorbox{aqua}{text}##{Left 11}
\fcolorbox	边框颜色框 \fcolorbox{red}{aqua}{text}	{Text}\fcolorbox{red}{aqua}{text}##{Left 16}

; 补全K：Bra-ket 括号矢量
\bra	左矢 \bra{\phi}	{Text}\bra{\phi}##{Left 5}
\ket	右矢 \ket{\psi}	{Text}\ket{\psi}##{Left 5}
\braket	内积 \braket{\phi|\psi}	{Text}\braket{\phi|\psi}##{Left 10}
\Bra	左矢 \Bra{\phi}	{Text}\Bra{\phi}##{Left 5}
\Ket	右矢 \Ket{\psi}	{Text}\Ket{\psi}##{Left 5}
\Braket	内积 \Braket{\phi|\psi}	{Text}\Braket{\phi|\psi}##{Left 10}

; 补全L：批注补充
\fbox	方框 \fbox{text}	{Text}\fbox{text}##{Left 5}
\pmb	粗体模拟 \pmb{\mu}	{Text}\pmb{\mu}##{Left 4}
\rule	横线 \rule[6pt]{2ex}{1ex}	{Text}\rule[6pt]{2ex}{1ex}##{Left 14}
\vcenter	垂直居中 \vcenter{\frac{\frac a b}c}	{Text}\vcenter{\frac{\frac a b}c}##{Left 18}


; 补全O：环境（含星号变体）
\aligned	对齐环境 \begin{aligned} a&=b+c \\ d+e&=f \end{aligned}	{Text}\begin{aligned} a&=b+c \\ d+e&=f \end{aligned}##{Left 29}
\alignedat	紧凑对齐 \begin{alignedat}{2} a&=b+c \\ d+e&=f \end{alignedat}	{Text}\begin{alignedat}{2} a&=b+c \\ d+e&=f \end{alignedat}##{Left 31}
\gathered	居中环境 \begin{gathered} a=b \\ e=b+c \end{gathered}	{Text}\begin{gathered} a=b \\ e=b+c \end{gathered}##{Left 26}
\split	拆分环境 \begin{split} a&=b+c \\ &=e+f \end{split}	{Text}\begin{split} a&=b+c \\ &=e+f \end{split}##{Left 26}
\equation	公式环境 \begin{equation} a=b+c \end{equation}	{Text}\begin{equation} a=b+c \end{equation}##{Left 19}
\smallmatrix	小矩阵 \begin{smallmatrix} a & b \\ c & d \end{smallmatrix}	{Text}\begin{smallmatrix} a & b \\ c & d \end{smallmatrix}##{Left 31}
\darray	显示数组 \begin{darray}{cc} a & b \\ c & d \end{darray}	{Text}\begin{darray}{cc} a & b \\ c & d \end{darray}##{Left 26}
\cd	交换图 \begin{CD} A @>a>> B \\ @VbVV @AAcA \\ C @= D \end{CD}	{Text}\begin{CD} A @>a>> B \\ @VbVV @AAcA \\ C @= D \end{CD}##{Left 42}
\alignstar	无编号对齐 \begin{align*} a&=b+c \\ d+e&=f \end{align*}	{Text}\begin{align*} a&=b+c \\ d+e&=f \end{align*}##{Left 28}
\gatherstar	无编号居中 \begin{gather*} a=b \\ e=b+c \end{gather*}	{Text}\begin{gather*} a=b \\ e=b+c \end{gather*}##{Left 25}
\alignatstar	无编号紧凑对齐 \begin{alignat*}{2} 10&x+&3&y=2\\ 3&x+&13&y=4 \end{alignat*}	{Text}\begin{alignat*}{2} 10&x+&3&y=2\\ 3&x+&13&y=4 \end{alignat*}##{Left 39}
\equationstar	无编号公式 \begin{equation*} a=b+c \end{equation*}	{Text}\begin{equation*} a=b+c \end{equation*}##{Left 20}

; 补全P：HTML/链接（需 trust 选项）
\href	链接 \href	{Text}\href{https://www.google.com}{google}##{Left 9}


; 补全S：集合与堆叠
\Set	集合 \Set{x | x<5}	{Text}\Set{x | x<5}##{Left 8}
\set	集合 \set{x | x<5}	{Text}\set{x | x<5}##{Left 8}
\substack	多行堆叠 \substack{0<i<m\\0<j<n}	{Text}\substack{0<i<m\\0<j<n}##{Left 13}
